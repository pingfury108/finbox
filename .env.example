# LLM（OpenAI 兼容接口，默认 DeepSeek）
LLM_BASE_URL=https://api.deepseek.com
LLM_API_KEY=
LLM_MODEL=deepseek-chat

# 模拟账户初始资金（元）
INITIAL_CAPITAL=200000

# 自选股票池，逗号分隔（可选，留空则完全由全市场初筛驱动）
WATCHLIST=

# 全市场初筛每个维度取前 N 只（涨幅/量比/60日涨幅，去重后约 3N）
SCREEN_TOP_N=20

# 行情采集间隔（秒）
COLLECT_INTERVAL_SECONDS=60

# AI 决策间隔（分钟）
AI_DECISION_INTERVAL_MINUTES=30

# 启动时补齐的日线历史长度（交易日数，约 250 = 1 年）
HISTORY_DAYS=250

# 数据库
DATABASE_URL=sqlite:///./finbox.db

# 行情数据源绕过本机代理（本机有 Clash 等代理时建议保持 true）
BYPASS_DATA_PROXY=true

# 同花顺金融数据服务 API Key（https://fuyao.aicubes.cn/admin）
HITHINK_FINANCE_API_KEY=
